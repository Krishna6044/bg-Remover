# Backend environment variables for AI Background Removal SaaS

# Comma-separated frontend origins allowed to call this API.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.onrender.com

CLIPDROP_API_KEY=your_clipdrop_api_key
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
MONGODB_DB_NAME=ai-background-removal
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net
PORT=4000